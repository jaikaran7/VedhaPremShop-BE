# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000

# Neon runtime: the pooled connection string (host contains "-pooler") with sslmode=require.
# Local: postgres://postgres@localhost:5432/vedhaprem_dev
DATABASE_URL=postgres://postgres@localhost:5432/vedhaprem_dev
# Neon migrations only. Direct (non-pooler) URL. Local can omit this and use DATABASE_URL.
# DIRECT_DATABASE_URL=postgres://postgres@localhost:5432/vedhaprem_dev
# Used only by `npm test`. Tests truncate every table in this database.
DATABASE_URL_TEST=postgres://postgres@localhost:5432/vedhaprem_test
# On Vercel keep this small (2). Neon’s pooler multiplexes; each function instance has its own pool.
DB_POOL_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API with cookies.
# Production uses this list only. Development also allows http:// on localhost and the private LAN.
# On Vercel set the frontend origin, for example https://vedhapremshop.vercel.app
CORS_ORIGINS=http://localhost:3000
# Leave false when the frontend proxies /api/v1 (the browser and the cookie stay on one site).
COOKIE_CROSS_SITE=false

# Dev seed only (refused when NODE_ENV=production).
SEED_USER_PASSWORD=

# AI consignment scanner (Purchases → Scan consignment). Without a key, uploads and manual review work but "Read documents" fails clearly.
# Key from https://aistudio.google.com/apikey — server side only, never NEXT_PUBLIC_.
GEMINI_API_KEY=
# Model ids (ai.google.dev/gemini-api/docs/models). Defaults shown; gemini-3.8-flash and gemini-4-argon need a billed key.
GEMINI_PRINTED_BILL_MODEL=gemini-3.5-flash-lite
GEMINI_HANDWRITING_MODEL=gemini-3.5-flash-lite
# Optional stronger model for the last retry. Leave empty unless the key can call it: an unusable model hangs until the timeout.
GEMINI_ESCALATION_MODEL=
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=45000
# Backup reader used when Gemini fails (no key, quota, outage, invalid answer). JPG/PNG/WEBP, at most 3 photos per document.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
