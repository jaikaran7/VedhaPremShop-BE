# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000

# Neon: use the pooled connection string (host contains "-pooler") with sslmode=require.
# Local: postgres://postgres@localhost:5432/vedhaprem_dev
DATABASE_URL=postgres://postgres@localhost:5432/vedhaprem_dev
# Used only by `npm test`. Tests truncate every table in this database.
DATABASE_URL_TEST=postgres://postgres@localhost:5432/vedhaprem_test
DB_POOL_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API with cookies.
# Production uses this list only. Development also allows http:// on localhost and the private LAN.
CORS_ORIGINS=http://localhost:3000
# true when the frontend and API are on different sites (e.g. vercel.app + railway.app); requires HTTPS.
COOKIE_CROSS_SITE=false

# Dev seed only (refused when NODE_ENV=production).
SEED_USER_PASSWORD=
